{
  "name": "codeigniter-chat",
  "version": "1.0.0",
  "description": "CodeIgniter Chat Application",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/pwa-icon.svg",
    "preview": "vite preview",
    "bench:post": "k6 run bench/post-messages.js",
    "bench:read": "k6 run bench/read-messages.js",
    "bench:ws": "k6 run bench/websocket-fanout.js",
    "check": "biome check --error-on-warnings . && svelte-check --config ./svelte.config.js --fail-on-warnings && vue-tsc --noEmit -p tsconfig.vue.json",
    "check:biome": "biome check --error-on-warnings .",
    "check:svelte": "svelte-check --config ./svelte.config.js --fail-on-warnings",
    "check:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "format": "biome check --write .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:codegen": "playwright codegen http://127.0.0.1:8085"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.104.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "workbox-background-sync": "^7.4.1",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
