# Generated by `php spark env:dump`. Do not edit by hand.
# Copy this file to .env and replace every CHANGE-ME value.

# Application
# Active CodeIgniter runtime environment.
# Type: enum (development, testing, production); required
CI_ENVIRONMENT=development
# Public application URL, including its scheme.
# Type: url; required
APP_URL=http://localhost:8000
# Host port exposed by the web container.
# Type: int (1–65535); optional
APP_PORT=8000

# Database
# Database driver used by the application.
# Type: enum (MySQLi, SQLite3); required
DB_DRIVER=MySQLi
# MySQL database name.
# Type: string; required when DB_DRIVER=MySQLi
DB_DATABASE=ci4_chat
# MySQL application account.
# Type: string; required when DB_DRIVER=MySQLi
DB_USERNAME=ci4_user
# Password for the MySQL application account.
# Type: string; required when DB_DRIVER=MySQLi
DB_PASSWORD=CHANGE-ME
# MySQL root password used only by Docker Compose.
# Type: string; optional
DB_ROOT_PASSWORD=CHANGE-ME
# Host port exposed by the MySQL container.
# Type: int (1–65535); optional
DB_PORT=3307

# WebSocket
# Host port exposed by the WebSocket server.
# Type: int (1–65535); optional
WEBSOCKET_PORT=8080
# Browser-accessible WebSocket URL using ws or wss.
# Type: websocket_url; required
WEBSOCKET_URL=ws://localhost:8080
# Secret reserved for signing WebSocket authentication material.
# Type: string; required
WEBSOCKET_TOKEN_SECRET=CHANGE-ME

# Development
# Allows destructive benchmark data seeding outside production.
# Type: bool; optional
BENCHMARK_MODE=false

# Push notifications
# Public VAPID key exposed to browser push clients.
# Type: string; optional
# push.vapidPublicKey=

# CodeIgniter overrides
# Direct override for the default database host.
# Type: string; optional
# database.default.hostname=
# Direct override for the default database name.
# Type: string; optional
# database.default.database=
# Direct override for the default database user.
# Type: string; optional
# database.default.username=
# Direct override for the default database password.
# Type: string; optional
# database.default.password=
# Direct override for the default database driver.
# Type: enum (MySQLi, SQLite3); optional
# database.default.DBDriver=
# Direct override for the default database port.
# Type: int (1–65535); optional
# database.default.port=
# CodeIgniter encryption key.
# Type: string; optional
# encryption.key=

# Email
# Email delivery protocol.
# Type: enum (mail, sendmail, smtp); optional
# email.protocol=
# SMTP server hostname.
# Type: string; optional
# email.SMTPHost=
# SMTP account username.
# Type: string; optional
# email.SMTPUser=
